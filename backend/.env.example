# ---------- server ----------
PORT=4000
FRONTEND_URL=http://localhost:3000
# Public URL of this API. Slack only accepts HTTPS redirect URLs, so for the
# Slack OAuth demo expose the API with a tunnel (e.g. `ngrok http 4000`) and put that URL here.
BACKEND_PUBLIC_URL=http://localhost:4000
JWT_SECRET=replace-with-a-long-random-string

# ---------- infra (docker compose up -d) ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# ---------- Google login (same OAuth client as the frontend) ----------
GOOGLE_CLIENT_ID=

# ---------- throughput & rate limiting ----------
# run the BullMQ worker inside the API process (set false and use `npm run dev:worker` to split them)
RUN_WORKER=true
WORKER_CONCURRENCY=5
# minimum gap between two sends from the same sender
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# hourly cap per sender mailbox
MAX_EMAILS_PER_HOUR_PER_SENDER=50
# hourly cap across all senders (0 = off)
MAX_EMAILS_PER_HOUR=200
SEND_MAX_ATTEMPTS=3

# ---------- SMTP (Ethereal) ----------
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
# Existing Ethereal accounts as "user:pass,user:pass". Leave empty to auto-create
# SENDER_COUNT accounts on first boot (they are saved in the DB and reused).
ETHEREAL_SENDERS=
SENDER_COUNT=3

# ---------- Slack OAuth app ----------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ---------- Bull Board basic auth (optional) ----------
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=
